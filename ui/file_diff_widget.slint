import {
    ListView,
    LineEdit,
    Button,
    CheckBox,
    Palette,
} from "std-widgets.slint";
import { Style } from "style.slint";

import {
    SlintLineStatus,
    SlintDiffLine,
    SlintMiniMapSegment,
    SlintLineStatus,
    SlintDiffLines,
    SlintFileDiffCallbacks,
    SlintFileDiffIdParamters,
    SlintReviewCallbacks,
    SlintNote,
    SlintNoteCallbacks,
    SlintContextType,
    SlintNoteIdParamters,
    DragFileLineNote,
} from "globals.slint";
import { ToolButton } from "controls/tool_button.slint";
import { DeleteButton } from "controls/delete_button.slint";

component LineNumber inherits HorizontalLayout {
    in property <int> line_number;
    in property <int> model_length;

    horizontal-stretch: 0;
    spacing: 5px;
    padding-left: 5px;
    padding-right: 5px;
    Rectangle {
        width: dummy.preferred-width;
        height: Style.size.file-diff-line-height;

        dummy := Text {
            text: "\{root.model_length}";
            color: Colors.transparent;
            font-size: Style.font.code_font_size;
            font-family: Style.font.code_font-family;
        }

        Text {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            vertical-alignment: center;
            horizontal-alignment: right;
            text: root.line_number != -1 ? root.line_number : "";
            font-size: Style.font.code_font_size;
            font-family: Style.font.code_font-family;
        }
    }

    Rectangle {
        width: 1px;
        background: grey;
    }
}

component CodeLine inherits Rectangle {
    in property <styled-text> styled_line;
    in property <SlintLineStatus> line_status;
    in property <int> max_chars_count;
    in property <length> visible-width;

    width: l.preferred-width;

    states [
        active-removed when line_status == SlintLineStatus.Removed: {
            background: Style.palette.diff_line_removed_color;
        }
        active-added when line_status == SlintLineStatus.Added: {
            background: Style.palette.diff_line_added_color;
        }
    ]
    l := HorizontalLayout {
        st := StyledText {
            property <length> text_width: Math.max(1, root.max_chars_count) * Style.font.code-font-size * 0.62 + 10px;

            width: Math.max(text_width, root.visible-width);
            height: Style.size.file-diff-line-height;
            horizontal-alignment: left;
            vertical-alignment: center;
            default-font-size: Style.font.code_font_size;
            default-font-family: Style.font.code_font_family;
            text: root.styled_line;
        }

        Rectangle {
            horizontal-stretch: 1;
        }
    }
}

component DiffLineView inherits VerticalLayout {
    in property <int> model_index;
    in property <length> visible-width;
    in property <[SlintNote]> note_model;
    in property <int> note_id;
    in-out property <[SlintDiffLine]> model;
    in-out property <int> edited_index;
    private property <int> note_index: note_id != -1 ? SlintNoteCallbacks.index_of_id(note_id, root.note_model) : -1;

    callback set_is_done(bool);
    callback set_note_text(string);
    callback delete_note();
    callback add_note(string);

    padding-left: 2px;
    padding-right: 2px;

    code-line := CodeLine {
        styled_line: model[root.model_index].styled_line;
        line_status: model[root.model_index].status;
        max_chars_count: model[root.model_index].max_chars_count;
        visible-width: root.visible-width;
    }

    if root.edited_index == model[root.model_index].line_id || root.note_index != -1: HorizontalLayout {
        alignment: start;

        init => {
            if root.note_index == -1 {
                note-edit.focus();
            }
        }

        if root.note_index != -1: ToolButton {
            source: root.note_model[root.note_index].is_fixed ? @image-url("../assets/icons/checkbox_checked_circle.svg") : @image-url("../assets/icons/checkbox_blank_circle.svg");
            clicked => {
                root.set_is_done(!root.note_model[root.note_index].is_fixed);
            }
        }

        if root.note_index != -1: DeleteButton {
            request-delete => {
                root.delete_note();
                note-edit.clear-focus();
            }
        }

        note-edit := LineEdit {
            text: root.note_index != -1 ? root.note_model[root.note_index].text : "";
            width: Math.min(600px, code-line.width);
            height: Style.size.file-diff-line-height;
            accepted(text) => {
                if root.note_index != -1 {
                    root.set_note_text(text);
                } else {
                    root.add_note(text);
                }
                root.edited_index = -1;
                self.clear-focus();
            }
        }
    }
}

component MiniMap inherits Rectangle {
    in property <[SlintMiniMapSegment]> mini-map-segments;
    in property <length> flickable-content-y;
    in property <length> flickable-content-height;
    in property <length> visible-height;

    callback set-scroll-fraction(fraction: float);
    callback scroll-by(delta: length);

    background: Palette.control-background;

    // 0.0 up, 1.0 down
    pure function scroll-fraction() -> float {
        if root.flickable-content-height <= root.visible-height {
            return 0.0;
        }
        return Math.clamp(
            -root.flickable-content-y / (root.flickable-content-height - root.visible-height),
            0.0, 1.0);
    }

    width: Style.size.scroll-bar-width;

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        for indicator[idx] in root.mini-map-segments: Rectangle {
            vertical-stretch: indicator.line_count;
            min-height: indicator.change_type == SlintLineStatus.Unchanged ? 0px : 2px;
            background: indicator.change_type == SlintLineStatus.Added ? #2ea043 :
                indicator.change_type == SlintLineStatus.Removed ? #f85149 :
                transparent;
        }
    }

    scroll-pad := Rectangle {
        private property <bool> is_pressed: false;
        private property <length> min-rect-height: 20px;

        z: 1000;
        y: root.scroll-fraction() * (root.height - self.height);

        height: Math.max(min-rect-height, root.visible-height * (root.visible-height / Math.max(root.flickable-content-height, 1px)));
        width: parent.width;
        background: Palette.background;
        opacity: tar.has-hover || is_pressed ? 0.7 : 0.5;
        border-color: Palette.foreground;
        border-width: 1px;
        tar := TouchArea {
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    is_pressed = true;
                }
                else if event.button == PointerEventButton.left && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    is_pressed = false;
                }
            }
            moved => {
                if is_pressed {
                    let new_y = Math.clamp(
                            scroll-pad.y + (self.mouse-y - self.pressed-y),
                            0px,
                            root.height - scroll-pad.height);
                    let fraction = new_y / (root.height - scroll-pad.height);
                    root.set_scroll_fraction(fraction);
                }
            }
        }
    }

    ta := TouchArea {
        clicked => {
            // center pad under cursor
            let target_y = self.pressed-y - scroll-pad.height / 2;
            let fraction = target_y / (root.height - scroll-pad.height);
            root.set_scroll_fraction(fraction);
        }
        scroll-event(event) => {
            if event.delta-y != 0 {
                root.scroll-by(event.delta-y);
                return accept;
            }
            reject
        }
    }
}

component LineNumberView inherits Rectangle {
    in property <SlintDiffLines> diff_lines;
    in-out property <int> edited_index;
    private property <length> indicator_width: 16px;

    callback change_note_line_number(note_id: int, line: int, content: string);
    callback copy_note(note_id: int, target_line: int);

    background: Palette.background;
    width: line-number-layout.preferred-width + Style.size.spacing;

    line-number-layout := VerticalLayout {
        x: 0px;
        spacing: 0px;

        for line[row] in root.diff_lines.buffered-lines: VerticalLayout {
            property <int> line_note_id: root.diff_lines.lines[line.line-id].note-id;

            private property <bool> has_note: line_note_id != -1;

            spacing: 0;

            HorizontalLayout {
                ln_new := LineNumber {
                    line_number: line.old_line_no;
                    model_length: root.diff_lines.lines.length;
                }

                ln_old := LineNumber {
                    line_number: line.new_line_no;
                    model_length: root.diff_lines.lines.length;
                }

                note-indicator := Rectangle {
                    property <bool> is_move_mode_enabled: false;
                    height: Style.size.file-diff-line-height;
                    width: root.indicator_width;
                    Image {
                        height: Style.size.image-width;
                        source: {
                            if has-note {
                                return @image-url("../assets/icons/notes.svg");
                            }
                            if touch.has-hover || root.edited_index == line.line_id {
                                return @image-url("../assets/icons/note-add.svg");
                            }
                            if drop.has-drag {
                                return @image-url("../assets/icons/note-add.svg");
                            }
                            return @image-url("");
                        }
                        colorize: drop.has-drag ? green : Palette.foreground;
                    }

                    drag := DragArea {
                        enabled: has_note;
                        drag-image: Palette.color-scheme == dark ? @image-url("../assets/icons/notes_drag_dark.svg") : @image-url("../assets/icons/notes_drag_light.svg");
                        drag-image-offset-x: -20;
                        drag-image-offset-y: 20;
                        data: DragFileLineNote.make-data(line.line-id, line_note_id);
                        allow-copy: true;
                        allow-move: true;
                        opacity: self.dragging ? 0.4 : 1.0;
                    }

                    touch := TouchArea {
                        enabled: !has_note && !drag.dragging;
                        clicked => {
                            root.edited_index = line.line_id;
                        }
                    }

                    drop := DropArea {
                        enabled: !has_note;
                        can-drop(event) => {
                            return DragFileLineNote.can-drop(event, line.line-id);
                        }
                        dropped(event) => {
                            let note_id = DragFileLineNote.dragged-note-id(event);
                            if note_id != -1 {
                                if event.proposed-action == DragAction.move {
                                    root.change_note_line_number(note-id, line.line-id, line.source-line);
                                }
                                else if event.proposed-action == DragAction.copy {
                                    root.copy_note(note_id, line.line-id);
                                }
                            }
                            return event.proposed-action;
                        }
                    }
                }
            }

            if has_note || line.line_id == root.edited_index: Rectangle {
                height: Style.size.file-diff-line-height;
            }
        }
    }
}

export component FileDiffWidget inherits HorizontalLayout {
    in property <int> diff_model_index;
    in property <SlintFileDiffIdParamters> file_diff_id_parameter; // TODO refactor
    private property <[SlintDiffLines]> loaded_file_diffs: SlintFileDiffCallbacks.loaded_file_diffs_model(file_diff_id_parameter.review-id-parameters); // TODO refactor
    private property <SlintDiffLines> diff_lines: loaded_file_diffs[diff_model_index]; // TODO refactor
    private property <int> line_count: diff_lines.lines.length;
    private property <int> selected_index: -1;
    private property <length> text_width: Math.max(1, root.diff_lines.max_chars_count) * Style.font.code-font-size * 0.62 + 10px;
    private property <length> visible-start-y: 0;
    private property <int> edited_index: -1;
    private property <length> last_requested_y: -1px;
    private property <[SlintNote]> note_model: SlintNoteCallbacks.note_source_model(root.file_diff_id_parameter.review_id_parameters);

    changed line_count => {
        if line_count > 0 {
            update_debounced();
        }
        else {
            root.visible-start-y = 0px;
        }
    }

    scroll_throttle_timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            scroll_throttle_timer.running = false;
            root.last_requested_y = flickable.content-y;

            root.visible-start-y = SlintFileDiffCallbacks.request_update_diff_model(
                root.diff_lines.buffered-lines,
                -flickable.content-y,
                flickable.height);
        }
    }

    function update_debounced() {
        scroll_throttle_timer.running = true;
    }

    flickable := Flickable {
        content-height: root.diff_lines.lines.length * Style.size.file-diff-line-height;
        content-width: root.text_width + line-number-view.width;
        mouse-drag-pan-enabled: false;

        changed content-y => {
            if Math.abs(self.content-y - root.last_requested_y) > 2px {
                update_debounced();
            }
        }
        changed height => {
            update_debounced();
        }

        content := Rectangle {
            x: 0;
            y: root.visible-start-y;
            width: 100%;

            VerticalLayout {
                x: line-number-view.width;
                spacing: 0px;
                width: root.text_width;

                for line[row] in root.diff_lines.buffered-lines: Rectangle {
                    property <int> line_note_id: root.diff_lines.lines[line.line-id].note-id;

                    private property <SlintNoteIdParamters> note_id_parameters: {
                        review_id_parameters: file_diff_id_parameter.review_id_parameters,
                        note_id: line_note_id
                    };

                    DiffLineView {
                        spacing: 0;
                        model_index: row;
                        model: root.diff_lines.buffered-lines;
                        edited_index <=> root.edited_index;
                        visible-width: flickable.width;
                        note_model: root.note_model;
                        note_id: root.diff_lines.lines[line.line_id].note_id;

                        set_is_done(is_done) => { SlintReviewCallbacks.change_note_is_done(note_id_parameters, is_done); }
                        set_note_text(text) => { SlintReviewCallbacks.change_note_text(note_id_parameters, text); }
                        delete_note => { SlintReviewCallbacks.delete_note(note_id_parameters); }
                        add_note(text) => { SlintNoteCallbacks.add_code_line_note(file_diff_id_parameter, text, line.source-line, line.line_id); }
                    }
                }
            }

            line-number-view := LineNumberView {
                diff_lines: root.diff_lines;
                edited_index <=> root.edited_index;
                x: -flickable.content-x; // NOTE fixed position

                change_note_line_number(note-id, line, content) => {
                    let ids = {
                        review_id_parameters: root.file_diff_id_parameter.review-id-parameters,
                        note_id: note-id,
                    };
                    SlintNoteCallbacks.set_file_line_note_context(ids, root.file_diff_id_parameter.file-diff-id, line, content);
                }
                copy_note(id, target-line) => {
                    let ids = {
                        review_id_parameters: root.file_diff_id_parameter.review-id-parameters,
                        note_id: id,
                    };
                    SlintNoteCallbacks.copy_file_line_note(ids, root.file_diff_id_parameter.file-diff-id, target-line);
                }
            }
        }
    }

    MiniMap {
        mini-map-segments: root.diff_lines.mini-map-segments;
        flickable-content-y: flickable.content-y;
        flickable-content-height: flickable.content-height;
        visible-height: flickable.height;
        set-scroll-fraction(fraction) => {
            let f = Math.clamp(fraction, 0.0, 1.0);
            if flickable.content-height <= flickable.height {
                flickable.content-y = 0;
            } else {
                flickable.content-y = -f * (flickable.content-height - flickable.height);
            }
        }
        scroll-by(delta) => {
            if flickable.content-height <= flickable.height {
                return;
            }
            let max_scroll = flickable.content-height - flickable.height;
            flickable.content-y = Math.clamp(flickable.content-y + delta, -max_scroll, 0px);
        }
    }
}
