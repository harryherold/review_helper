import {
    ListView,
    LineEdit,
    Button,
    CheckBox,
    Palette,
} from "std-widgets.slint";
import { Style } from "style.slint";

import {
    SlintLineStatus,
    SlintDiffLine,
    SlintMiniMapSegment,
    SlintLineStatus,
    SlintDiffLines,
    SlintFileDiffCallbacks,
    SlintFileDiffIdParamters,
    SlintReviewCallbacks,
} from "globals.slint";
import { ToolButton } from "controls/tool_button.slint";
import { DeleteButton } from "controls/delete_button.slint";

component LineNumber inherits HorizontalLayout {
    in property <int> line_number;
    in property <int> model_length;

    horizontal-stretch: 0;
    spacing: 5px;
    padding-left: 5px;
    padding-right: 5px;
    Rectangle {
        width: dummy.preferred-width;
        height: Style.size.file-diff-line-height;

        dummy := Text {
            text: "\{root.model_length}";
            color: Colors.transparent;
            font-size: Style.font.code_font_size;
            font-family: Style.font.code_font-family;
        }

        Text {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            vertical-alignment: center;
            horizontal-alignment: right;
            text: root.line_number != -1 ? root.line_number : "";
            font-size: Style.font.code_font_size;
            font-family: Style.font.code_font-family;
        }
    }

    Rectangle {
        width: 1px;
        background: grey;
    }
}

component NoteAddButton inherits Rectangle {
    in property <length> image_height;
    in property <bool> is_enabled;
    callback clicked();

    width: 32px;

    Image {
        source: ta.has-hover ? @image-url("../assets/icons/note-add.svg") : @image-url("");
        height: root.image_height;
        y: 0;
    }

    ta := TouchArea {
        enabled: is_enabled;
        clicked => clicked();
    }
}

component CodeLine inherits Rectangle {
    in property <styled-text> styled_line;
    in property <SlintLineStatus> line_status;
    in property <int> max_chars_count;
    in property <length> visible-width;

    width: l.preferred-width;

    states [
        active-removed when line_status == SlintLineStatus.Removed: {
            background: Style.palette.diff_line_removed_color;
        }
        active-added when line_status == SlintLineStatus.Added: {
            background: Style.palette.diff_line_added_color;
        }
    ]
    l := HorizontalLayout {
        st := StyledText {
            property <length> text_width: Math.max(1, root.max_chars_count) * Style.font.code-font-size * 0.62 + 10px;

            width: Math.max(text_width, root.visible-width);
            height: Style.size.file-diff-line-height;
            horizontal-alignment: left;
            vertical-alignment: center;
            default-font-size: Style.font.code_font_size;
            default-font-family: Style.font.code_font_family;
            text: root.styled_line;
        }

        Rectangle {
            horizontal-stretch: 1;
        }
    }
}

component NoteView inherits Rectangle {
    in property <string> note;
    in property <bool> is_done;
    in property <bool> start-in-edit: false;
    private property <bool> is_edit: false;

    callback set_note(string);
    callback set_is_done(bool);
    callback select();
    callback deselect();
    callback delete_note();

    border-color: Palette.border;
    border-width: 1px;
    background: Palette.control-background;

    init => {
        if root.start-in-edit && root.note.is-empty {
            is_edit = true;
        }
    }

    HorizontalLayout {
        padding: 8px;
        spacing: 5px;

        if !is_edit: ToolButton {
            source: root.is_done ? @image-url("../assets/icons/checkbox_checked_circle.svg") : @image-url("../assets/icons/checkbox_blank_circle.svg");
            clicked => { root.set_is_done(!root.is_done); }
        }
        if !is_edit: DeleteButton {
            request-delete => {
                root.delete_note();
            }
        }
        if !is_edit: ToolButton {
            source: @image-url("../assets/icons/edit.svg");
            height: Style.size.control-height;
            width: self.height;
            clicked => {
                is_edit = true;
                root.select();
            }
        }

        if is_edit: Rectangle {
            Timer {
                interval: 5ms;
                running: true;
                triggered => {
                    self.running = false;
                    le.select-all();
                    le.focus();
                }
            }

            le := LineEdit {
                width: 100%;
                height: 100%;
                text: root.note;

                function leave-edit(commit: bool) {
                    if commit {
                        root.set_note(self.text);
                    } else {
                        self.text = root.note;
                    }
                    is_edit = false;
                    if (commit ? self.text : root.note).is-empty {
                        root.deselect();
                    }
                    self.clear-focus();
                }

                changed has-focus => {
                    if !self.has-focus {
                        leave-edit(true);
                    }
                }
                accepted(text) => {
                    self.text = text;
                    leave-edit(true);
                }
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        leave-edit(false);
                        return accept;
                    }
                    return reject;
                }
            }
        }
        if !is_edit: HorizontalLayout {
            Rectangle {
                width: 18px;
            }

            Text {
                text: root.note;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-alignment: left;
            }
        }
    }
}

component DiffLineView inherits VerticalLayout {
    in property <int> model_index;
    in property <length> visible-width;
    in-out property <[SlintDiffLine]> model;
    in-out property <int> edited_index;

    padding-left: 2px;
    padding-right: 2px;

    code-line := CodeLine {
        styled_line: model[root.model_index].styled_line;
        line_status: model[root.model_index].status;
        max_chars_count: model[root.model_index].max_chars_count;
        visible-width: root.visible-width;
    }

    if root.edited_index == model[root.model_index].line_id || !model[root.model_index].note.is-empty: LineEdit {
        text: model[root.model_index].note;
        max-width: code-line.width;
        height: Style.size.file-diff-line-height;
        accepted(text) => {
            model[root.model_index].note = text;
        }
    }
}

component MiniMap inherits Rectangle {
    in property <[SlintMiniMapSegment]> mini-map-segments;
    in property <length> viewport-y;
    in property <length> viewport-height;
    in property <length> visible-height;

    callback set-scroll-fraction(fraction: float);
    callback scroll-by(delta: length);

    background: Palette.control-background;

    // 0.0 up, 1.0 down
    pure function scroll-fraction() -> float {
        if root.viewport-height <= root.visible-height {
            return 0.0;
        }
        return Math.clamp(
            -root.viewport-y / (root.viewport-height - root.visible-height),
            0.0, 1.0);
    }

    width: Style.size.scroll-bar-width;

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        for indicator[idx] in root.mini-map-segments: Rectangle {
            vertical-stretch: indicator.line_count;
            min-height: indicator.change_type == SlintLineStatus.Unchanged ? 0px : 2px;
            background: indicator.change_type == SlintLineStatus.Added ? #2ea043 :
                indicator.change_type == SlintLineStatus.Removed ? #f85149 :
                transparent;
        }
    }

    scroll-pad := Rectangle {
        private property <bool> is_pressed: false;
        private property <length> min-rect-height: 20px;

        z: 1000;
        y: root.scroll-fraction() * (root.height - self.height);

        // height: Math.max(min-rect-height, root.visible-height * (root.visible-height / root.viewport-height));
        height: Math.max(min-rect-height, root.visible-height * (root.visible-height / Math.max(root.viewport-height, 1px)));
        width: parent.width;
        background: Palette.background;
        opacity: tar.has-hover || is_pressed ? 0.7 : 0.5;
        border-color: Palette.foreground;
        border-width: 1px;
        tar := TouchArea {
            pointer-event(event) => {
                if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                    is_pressed = true;
                }
                else if event.button == PointerEventButton.left && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                    is_pressed = false;
                }
            }
            moved => {
                if is_pressed {
                    let new_y = Math.clamp(
                            scroll-pad.y + (self.mouse-y - self.pressed-y),
                            0px,
                            root.height - scroll-pad.height);
                    let fraction = new_y / (root.height - scroll-pad.height);
                    root.set_scroll_fraction(fraction);
                }
            }
        }
    }

    ta := TouchArea {
        clicked => {
            // center pad under cursor
            let target_y = self.pressed-y - scroll-pad.height / 2;
            let fraction = target_y / (root.height - scroll-pad.height);
            root.set_scroll_fraction(fraction);
        }
        scroll-event(event) => {
            if event.delta-y != 0 {
                root.scroll-by(event.delta-y);
                return accept;
            }
            reject
        }
    }
}

export component FileDiffWidget inherits HorizontalLayout {
    in property <int> diff_model_index;
    in property <SlintFileDiffIdParamters> file_diff_id_parameter; // TODO refactor
    private property <[SlintDiffLines]> loaded_file_diffs: SlintFileDiffCallbacks.loaded_file_diffs_model(file_diff_id_parameter.review-id-parameters); // TODO refactor
    private property <SlintDiffLines> diff_lines: loaded_file_diffs[diff_model_index]; // TODO refactor
    private property <int> line_count: diff_lines.lines.length;
    private property <int> selected_index: -1;
    private property <length> text_width: Math.max(1, root.diff_lines.max_chars_count) * Style.font.code-font-size * 0.62 + 10px;
    private property <length> visible-start-y: 0;
    private property <int> edited_index: -1;

    changed line_count => {
        if line_count > 0 {
            root.visible-start-y = SlintFileDiffCallbacks.request_update_diff_model(root.diff_lines.buffered-lines, -flickable.viewport-y, flickable.height);
        }
        else {
            root.visible-start-y = 0px;
        }
    }

    private property <length> last_requested_y: -1px;
    private property <bool> pending_update: false;

    scroll_throttle_timer := Timer {
        interval: 16ms;
        running: root.pending_update;
        triggered => {
            root.pending_update = false;
            root.last_requested_y = flickable.viewport-y;

            root.visible-start-y = SlintFileDiffCallbacks.request_update_diff_model(
                root.diff_lines.buffered-lines,
                -flickable.viewport-y,
                flickable.height);
        }
    }

    flickable := Flickable {
        private property <length> indicator_width: 16px;
        private property <length> line_number_spacing: 5px;
        private property <int> counter: 0;

        viewport-height: root.diff_lines.lines.length * Style.size.file-diff-line-height;
        viewport-width: root.text_width + line-number-rect.width;

        changed viewport-y => {
            if Math.abs(self.viewport-y - root.last_requested_y) > 2px {
                root.pending_update = true;
            }
        }
        changed height => {
            root.pending_update = true;
        }

        content := Rectangle {
            x: 0;
            y: root.visible-start-y;
            width: 100%;

            VerticalLayout {
                x: line-number-rect.width;
                spacing: 0px;
                width: root.text_width;

                for line[row] in root.diff_lines.buffered-lines: Rectangle {
                    DiffLineView {
                        spacing: 0;
                        model_index: row;
                        model: root.diff_lines.buffered-lines;
                        edited_index: root.edited_index;
                        visible-width: flickable.width;
                    }
                }
            }

            line-number-rect := Rectangle {
                x: -flickable.viewport-x; // NOTE fixed position
                background: Palette.background;
                width: line-number-layout.preferred-width + Style.size.spacing;

                line-number-layout := VerticalLayout {
                    x: 0px;
                    spacing: 0px;

                    for line[row] in root.diff_lines.buffered-lines: VerticalLayout {
                        private property <bool> has_note: !line.note.is-empty;

                        spacing: 0;

                        HorizontalLayout {
                            ln_new := LineNumber {
                                line_number: line.old_line_no;
                                model_length: root.diff_lines.lines.length;
                            }

                            ln_old := LineNumber {
                                line_number: line.new_line_no;
                                model_length: root.diff_lines.lines.length;
                            }

                            note-indicator := Rectangle {
                                height: Style.size.file-diff-line-height;
                                width: flickable.indicator_width;
                                Image {
                                    height: 20px;
                                    source: {
                                        if has-note {
                                            return @image-url("../assets/icons/notes.svg");
                                        }
                                        if touch.has-hover || root.edited_index == line.line_id {
                                            return @image-url("../assets/icons/note-add.svg");
                                        }
                                        return @image-url("");
                                    }
                                    colorize: Palette.foreground;
                                }

                                touch := TouchArea {
                                    clicked => {
                                        root.edited_index = line.line_id;
                                    }
                                }
                            }
                        }

                        if !line.note.is-empty || line.line_id == root.edited_index: Rectangle {
                            height: Style.size.file-diff-line-height;
                        }
                    }
                }
            }
        }
    }

    MiniMap {
        mini-map-segments: root.diff_lines.mini-map-segments;
        viewport-y: flickable.viewport-y;
        viewport-height: flickable.viewport-height;
        visible-height: flickable.height;
        set-scroll-fraction(fraction) => {
            let f = Math.clamp(fraction, 0.0, 1.0);
            if flickable.viewport-height <= flickable.height {
                flickable.viewport-y = 0;
            } else {
                flickable.viewport-y = -f * (flickable.viewport-height - flickable.height);
            }
        }
        scroll-by(delta) => {
            if flickable.viewport-height <= flickable.height {
                return;
            }
            let max_scroll = flickable.viewport-height - flickable.height;
            flickable.viewport-y = Math.clamp(flickable.viewport-y + delta, -max_scroll, 0px);
        }
    }
}
